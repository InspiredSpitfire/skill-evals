{
  "claude": {
    "command": [
      "claude",
      "--print",
      "--output-format", "json",
      "--no-session-persistence",
      "--disable-slash-commands",
      "--setting-sources", "",
      "--tools", "",
      "--model", "claude-opus-5"
    ],
    "response_format": "claude-json",
    "budget_flag": "--max-budget-usd",
    "isolate": {
      "env_var": "CLAUDE_CONFIG_DIR",
      "link": ["~/.claude/.credentials.json"]
    }
  },
  "codex": {
    "command": [
      "codex", "exec",
      "--ephemeral",
      "--ignore-user-config",
      "--sandbox", "read-only",
      "--skip-git-repo-check",
      "--json",
      "--model", "gpt-5.6-sol",
      "-c", "model_reasoning_effort=medium"
    ],
    "response_format": "codex-jsonl",
    "isolate": {
      "env_var": "CODEX_HOME",
      "link": ["~/.codex/auth.json"]
    }
  }
}
